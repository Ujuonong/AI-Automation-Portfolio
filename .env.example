# Application
APP_NAME="Bulus Ujuonong James | DE-JUNONG AI"
APP_ENV=development
APP_URL=http://localhost/DEjunong%20Portfolio/public
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=portfolio_cms
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_NAME=portfolio_session
SESSION_LIFETIME=7200

# Security
CSRF_KEY=change_me_to_a_random_secret_string
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Uploads
MAX_FILE_SIZE=8388608
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
ALLOWED_DOCUMENT_EXTENSIONS=pdf

# AI consultation is configured from the admin dashboard (Settings -> AI Consultation),
# not from this file. The webhook URL is stored in the database (site_settings).