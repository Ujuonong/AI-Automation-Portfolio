{
    "name": "dejunong/portfolio-cms",
    "description": "Personal portfolio CMS for Bulus Ujuonong James - AI Automation Engineer & Consultant",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-fileinfo": "*"
    },
    "autoload": {
        "psr-4": {
            "Portfolio\\": "app"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "db:migrate": "php database/migrate.php"
    }
}